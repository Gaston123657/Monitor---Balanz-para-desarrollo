{
  "name": "Dark Financial Dashboard Design System",
  "version": "1.0.0",
  "description": "Reusable design system for financial data dashboards with dark theme",

  "colors": {
    "primary": {
      "bg_dark": "#0b1230",
      "bg_darker": "#050915",
      "bg_darkest": "#030609"
    },
    "secondary": {
      "bg_table_header": "#111e55",
      "bg_table_alt1": "#0f1a47",
      "bg_table_alt2": "#0b1230",
      "border": "#1f2a5a"
    },
    "text": {
      "white": "white",
      "light": "#e6ecff",
      "subtitle": "#a8b4ff",
      "muted": "#7a85cc"
    },
    "semantic": {
      "positive": "#6CFF8F",
      "negative": "#FF6B6B",
      "neutral": "#a8b4ff",
      "warning": "#FFD93D",
      "info": "#6CB4FF"
    }
  },

  "typography": {
    "font_family_primary": "Segoe UI, Tahoma, Geneva, Verdana, sans-serif",
    "font_family_monospace": "Courier New, monospace",
    "sizes": {
      "title": 20,
      "subtitle": 11,
      "table": 10,
      "body": 12,
      "small": 9
    },
    "weights": {
      "normal": 400,
      "medium": 500,
      "bold": 700
    }
  },

  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px"
  },

  "components": {
    "table": {
      "row_height": 1.6,
      "header_background": "#111e55",
      "alt_row_1": "#0f1a47",
      "alt_row_2": "#0b1230",
      "border_color": "#1f2a5a",
      "text_color": "#e6ecff"
    },
    "header": {
      "background": "#0b1230",
      "text_color": "white",
      "subtitle_color": "#a8b4ff",
      "font_size": 18
    },
    "card": {
      "background": "#111e55",
      "border": "1px solid #1f2a5a",
      "border_radius": "4px",
      "padding": "16px"
    }
  },

  "layout": {
    "table_bbox": [0.0, 0.24, 1.0, 0.50],
    "title_y": 0.84,
    "subtitle_y": 0.80,
    "margin": "16px",
    "max_width": "1600px"
  },

  "theme": {
    "name": "Dark Financial",
    "mode": "dark",
    "contrast_ratio": "WCAG AA",
    "accessibility": "High contrast for financial data readability"
  }
}
